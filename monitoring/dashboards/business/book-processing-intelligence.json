{
  "dashboard": {
    "id": null,
    "title": "LibraryOfBabel Book Processing Intelligence - AI Agent Ready",
    "tags": ["libraryofbabel", "business", "books", "ai-intelligence", "conversational"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "1m",
    "annotations": {
      "list": [
        {
          "name": "Book Processing Milestones",
          "datasource": "Loki",
          "enable": true,
          "expr": "{job=\"libraryofbabel\", component=\"ultimate_library\"} |~ \"completed|milestone|batch\"",
          "iconColor": "green",
          "textFormat": "{{ ai_book_summary }}",
          "titleFormat": "Processing Milestone"
        }
      ]
    },
    "description": "AI Agent Ready business intelligence dashboard for LibraryOfBabel book processing analytics. Designed for conversational queries and natural language interaction.",
    "panels": [
      {
        "id": 1,
        "title": "📚 AI Business Summary - Books Processed",
        "type": "stat",
        "targets": [
          {
            "expr": "libraryofbabel_books_processed_total",
            "legendFormat": "Books Processed",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "libraryofbabel_genre_accuracy_percentage",
            "legendFormat": "Genre Accuracy %",
            "refId": "B",
            "datasource": "Prometheus"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "gradient",
              "orientation": "horizontal"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1000
                },
                {
                  "color": "green",
                  "value": 1500
                }
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {
            "titleSize": 18,
            "valueSize": 24
          },
          "textMode": "auto"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "description": "AI Agent Summary: LibraryOfBabel has successfully processed {{ books_processed }} books with {{ genre_accuracy }}% genre classification accuracy. Ask: 'How many books have we processed?'"
      },
      {
        "id": 2,
        "title": "🎯 Classification Quality Intelligence",
        "type": "gauge",
        "targets": [
          {
            "expr": "libraryofbabel_genre_accuracy_percentage",
            "legendFormat": "Accuracy",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 90
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            },
            "unit": "percent",
            "min": 80,
            "max": 100
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "text": {}
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "description": "AI Agent Intelligence: Genre classification accuracy gauge. Query: 'How accurate is our book classification?' Current: {{ accuracy }}%"
      },
      {
        "id": 3,
        "title": "📈 Book Processing Velocity - AI Analytics",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(libraryofbabel_books_processed_total[1h])",
            "legendFormat": "Books/Hour",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "increase(libraryofbabel_books_reclassified_total[1h])",
            "legendFormat": "Reclassified/Hour",
            "refId": "B",
            "datasource": "Prometheus"
          }
        ],
        "yAxes": [
          {
            "label": "Books",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "xAxis": {
          "show": true
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        },
        "legend": {
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true,
          "min": true,
          "show": true,
          "total": false,
          "values": true
        },
        "description": "AI Agent Analytics: Book processing velocity trends. Natural language query: 'How fast are we processing books?' Answer: {{ books_per_hour }} books per hour."
      },
      {
        "id": 4,
        "title": "🏷️ Genre Classification Breakdown - AI Insights",
        "type": "bargauge",
        "targets": [
          {
            "expr": "libraryofbabel_books_processed_total",
            "legendFormat": "Total Books",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "libraryofbabel_books_reclassified_total",
            "legendFormat": "Reclassified",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "libraryofbabel_books_confirmed_total",
            "legendFormat": "Confirmed",
            "refId": "C",
            "datasource": "Prometheus"
          },
          {
            "expr": "libraryofbabel_books_failed_total",
            "legendFormat": "Failed",
            "refId": "D",
            "datasource": "Prometheus"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "gradient",
              "orientation": "horizontal"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "showUnfilled": true,
          "text": {}
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 17
        },
        "description": "AI Agent Insight: Book classification status breakdown. Ask: 'How many books were reclassified?' Answer: {{ reclassified }} books needed reclassification."
      },
      {
        "id": 5,
        "title": "📊 Processing Efficiency Matrix",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(libraryofbabel_books_processed_total[1h])",
            "legendFormat": "{{ hour }}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 17
        },
        "description": "AI Agent Pattern Recognition: Processing efficiency heatmap showing peak processing hours and patterns."
      },
      {
        "id": 6,
        "title": "📑 Recent Book Processing Events - Conversational Log",
        "type": "logs",
        "targets": [
          {
            "expr": "{job=\"libraryofbabel\", component=\"ultimate_library\"} | json | line_format \"{{.ai_book_summary}}\"",
            "refId": "A",
            "datasource": "Loki"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 26
        },
        "description": "AI Agent Context: Recent book processing events with natural language summaries. Query: 'What books were processed recently?'"
      },
      {
        "id": 7,
        "title": "📈 Business KPIs - AI Dashboard",
        "type": "table",
        "targets": [
          {
            "expr": "libraryofbabel_books_processed_total",
            "legendFormat": "Total Books",
            "refId": "A",
            "datasource": "Prometheus",
            "instant": true
          },
          {
            "expr": "libraryofbabel_genre_accuracy_percentage",
            "legendFormat": "Accuracy %",
            "refId": "B",
            "datasource": "Prometheus",
            "instant": true
          },
          {
            "expr": "rate(libraryofbabel_books_processed_total[24h]) * 24 * 3600",
            "legendFormat": "Books/Day",
            "refId": "C",
            "datasource": "Prometheus",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "job": true,
                "instance": true
              },
              "indexByName": {},
              "renameByName": {
                "Value #A": "Total Books Processed",
                "Value #B": "Genre Accuracy %",
                "Value #C": "Processing Rate (Books/Day)"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "center",
              "displayMode": "color-background"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 38
        },
        "description": "AI Agent Business Intelligence: Key performance indicators in tabular format. Ask: 'What are our main business metrics?'"
      }
    ],
    "templating": {
      "list": [
        {
          "name": "business_view",
          "type": "custom",
          "options": [
            {
              "text": "Executive Summary",
              "value": "executive"
            },
            {
              "text": "Operational Detail",
              "value": "operational"
            },
            {
              "text": "Quality Focus",
              "value": "quality"
            }
          ],
          "current": {
            "text": "Executive Summary",
            "value": "executive"
          },
          "description": "AI Agent Business View Mode"
        },
        {
          "name": "time_range",
          "type": "interval",
          "options": [
            {
              "text": "Last Hour",
              "value": "1h"
            },
            {
              "text": "Last 24 Hours",
              "value": "24h"
            },
            {
              "text": "Last Week",
              "value": "7d"
            }
          ],
          "current": {
            "text": "Last 24 Hours",
            "value": "24h"
          },
          "description": "AI Agent Time Range for Analysis"
        }
      ]
    },
    "links": [
      {
        "title": "AI Agent Natural Language Queries",
        "url": "http://localhost:8080/api/v1/ai/query",
        "type": "link",
        "icon": "question",
        "tags": ["ai-agent", "natural-language"]
      },
      {
        "title": "Business Intelligence API",
        "url": "http://localhost:8080/api/v1/metrics/summary",
        "type": "link",
        "icon": "external link",
        "tags": ["api", "business"]
      }
    ]
  }
}